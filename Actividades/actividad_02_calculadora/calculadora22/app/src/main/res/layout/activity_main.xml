<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8FAFC"
    android:gravity="bottom">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="#0F172A"
        android:gravity="end"
        android:padding="20dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:layout_marginBottom="16dp" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5"
        android:useDefaultMargins="true">

        <Button android:id="@+id/btnClear" android:text="C" android:backgroundTint="#EF4444" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btnDiv" android:text="/" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btnMult" android:text="*" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btnSub" android:text="-" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />

        <Button android:id="@+id/btn7" android:text="7" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn8" android:text="8" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn9" android:text="9" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btnAdd" android:text="+" android:backgroundTint="#0284C7" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />

        <Button android:id="@+id/btn4" android:text="4" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn5" android:text="5" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn6" android:text="6" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btnEquals" android:text="=" android:layout_rowSpan="3" android:layout_gravity="fill" android:backgroundTint="#10B981" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:textSize="22sp" />

        <Button android:id="@+id/btn1" android:text="1" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn2" android:text="2" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />
        <Button android:id="@+id/btn3" android:text="3" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />

        <Button android:id="@+id/btn0" android:text="0" android:layout_columnSpan="2" android:layout_gravity="fill_horizontal" android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="2" android:textSize="22sp" />
        <Button android:id="@+id/btnDot" android:text="." android:backgroundTint="#334155" android:textColor="#FFFFFF" android:layout_width="0dp" android:layout_height="70dp" android:layout_columnWeight="1" android:textSize="22sp" />

    </GridLayout>

</LinearLayout>