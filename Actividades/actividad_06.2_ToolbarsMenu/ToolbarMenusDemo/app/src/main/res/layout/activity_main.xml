<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- Material Design 3 Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0284C7"
        app:title="Mi Aplicación"
        app:titleTextColor="#FFFFFF"
        android:elevation="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Uso de Toolbar y Menús"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prueba los íconos superiores y presiona el botón para probar un PopupMenu."
            android:gravity="center"
            android:textColor="#64748B"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnPopupMenu"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:text="Mostrar PopupMenu Contextual"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</LinearLayout>